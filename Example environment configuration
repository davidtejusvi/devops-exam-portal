# -----------------------------------------------------------------------------
# Example environment configuration
# This file is provided for educational/reference purposes only.
# Do NOT store or commit real passwords, API keys, secrets, or production values.
# Copy this file to .env and replace the placeholder values with your own.
# -----------------------------------------------------------------------------


# Root .env — shared values used by docker-compose
MYSQL_ROOT_PASSWORD=rootpassword
DB_NAME=devops_exam_db
DB_USER=examuser
DB_PASSWORD=exampassword

#Front end
VITE_API_BASE_URL=/api

#Backend
PORT=5001
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=devops_exam_db
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Session
SESSION_SECRET=your_session_secret_change_in_production

# Google OAuth (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
